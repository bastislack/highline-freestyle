{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:fix": "npm run lint:eslint:fix && npm run lint:prettier:fix",
    "lint:eslint": "eslint --ext .ts,.vue,.json src",
    "lint:eslint:fix": "eslint --ext .ts,.vue,.json src --fix",
    "lint:prettier": "prettier src --check",
    "lint:prettier:fix": "prettier src --write",
    "lint:staged": "lint-staged",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-icons/vue": "^1.0.0",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^10.11.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dexie": "^3.2.4",
    "lucide-vue-next": "^0.294.0",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vee-validate": "^4.15.0",
    "vue": "^3.3.4",
    "vue-i18n": "^9.3.0-beta.27",
    "vue-router": "^4.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@iconify/vue": "^4.1.1",
    "@types/node": "^20.5.9",
    "@types/youtube": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.15",
    "chalk": "^5.3.0",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "globby": "^13.2.2",
    "happy-dom": "^20.8.3",
    "husky": "^8.0.0",
    "lint-staged": "^15.1.0",
    "postcss": "^8.4.33",
    "prettier": "3.1.0",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.69.5",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^7.1.3",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.0.6",
    "yaml": "^2.3.2",
    "zod-to-json-schema": "^3.21.4",
    "zx": "^7.2.3"
  }
